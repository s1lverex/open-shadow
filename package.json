{
  "name": "openshadow",
  "productName": "Open Shadow",
  "version": "1.1.0",
  "private": true,
  "description": "Open Shadow",
  "main": "desktop/main.js",
  "scripts": {
    "test": "node --test tests/",
    "start": "electron .",
    "shortcut": "electron . --create-shortcut",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --universal",
    "dist:linux": "electron-builder --linux tar.gz"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.openshadow.app",
    "productName": "Open Shadow",
    "icon": "desktop/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open Shadow",
      "artifactName": "OpenShadow-${version}-Setup.exe",
      "uninstallDisplayName": "Open Shadow"
    },
    "mac": {
      "target": "dmg",
      "icon": "desktop/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "OpenShadow-${version}-mac.${ext}",
      "identity": null
    },
    "linux": {
      "target": "tar.gz",
      "icon": "desktop/icon.png",
      "category": "Utility",
      "artifactName": "OpenShadow-${version}-linux.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
